# Copy to /home/jobbot/.config/jobbot/env and chmod 600. Never commit real values.
TELEGRAM_BOT_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
# Comma-separated Telegram chat IDs allowed to approve candidates and use admin commands.
ADMIN_IDS=
JOBBOT_TOP_N=5
# Only affects message texts and the hold-until-delivery rule. The actual delivery time is the
# OnCalendar of jobbot-deliver.timer; keep both equal.
JOBBOT_DELIVERY_HOUR=7
